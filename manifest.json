{
  "manifest_version": 3,
  "name": "Kahoot AI Solver Helper",
  "version": "1.0",
  "description": "مساعد ذكي يحل أسئلة Kahoot تلقائياً داخل الصفحة نفسها",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.kahoot.it/*"],
      "js": ["content/clicker.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.kahoot.it/*"],
      "js": [
        "config.js",
        "content/scraper.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/api.js"
  }
}